void to_lower(const char *src, char *dst)
{
    int i;
    for (i = 0; src[i]; i++) dst[i] = (char)tolower((unsigned char)src[i]);
    dst[i] = '\0';
}

void read_line(char *buf, int size)
{
    if (!fgets(buf, size, stdin)) { buf[0] = '\0'; return; }
    buf[strcspn(buf, "\n")] = '\0';
}

int line_mask(int s)
{
    int mask = 0;
    for (int j = 0; j < nstations; j++)
        if (km[s][j] > 0) mask |= 1 << lineof[s][j];
    return mask;
}

int ask_station(const char *prompt)
{
    char input[40], a[40], b[40];
    while (1) {
        printf("%s", prompt);
        read_line(input, sizeof input);
        if (input[0] == '\0') return -1;
        to_lower(input, a);

        int found[MAXS], n = 0;
        for (int i = 0; i < nstations; i++) {
            to_lower(station[i], b);
            if (strcmp(a, b) == 0) return i;
            if (strstr(b, a)) found[n++] = i;
        }
        if (n == 1) { printf("  -> %s\n", station[found[0]]); return found[0]; }
        if (n == 0) { printf("  No station found. Try again (Enter = cancel).\n"); continue; }
        printf("  Did you mean:\n");
        for (int i = 0; i < n; i++) printf("    - %s\n", station[found[i]]);
    }
}

float hop_time(float distance) { return distance * 2.0f + 1.0f; }

int find_route(int src, int dst, int path[])
{
    float best[MAXS];
    int   prev[MAXS], done[MAXS] = {0};
    for (int i = 0; i < nstations; i++) { best[i] = INF; prev[i] = -1; }
    best[src] = 0;

    for (int round = 0; round < nstations; round++) {

        int u = -1;
        for (int i = 0; i < nstations; i++)
            if (!done[i] && (u == -1 || best[i] < best[u])) u = i;
        if (u == -1 || best[u] >= INF) break;
        done[u] = 1;

        for (int v = 0; v < nstations; v++) {
            if (km[u][v] > 0 && !done[v]) {
                float t = best[u] + hop_time(km[u][v]);
                if (t < best[v]) { best[v] = t; prev[v] = u; }
            }
        }
    }
    if (best[dst] >= INF) return 0;

    int tmp[MAXS], n = 0;
    for (int v = dst; v != -1; v = prev[v]) tmp[n++] = v;
    for (int i = 0; i < n; i++) path[i] = tmp[n - 1 - i];
    return n;
}

int fare_for(float distance, int sunday)
{
    const int weekday[6] = {11, 21, 32, 43, 54, 64};
    const int holiday[6] = {11, 11, 21, 32, 43, 54};
    int slab = distance <= 2 ? 0 : distance <= 5 ? 1 : distance <= 12 ? 2 :
               distance <= 21 ? 3 : distance <= 32 ? 4 : 5;
    return sunday ? holiday[slab] : weekday[slab];
}

void plan_journey(void)
{
    printf("\n(Type part of a name, e.g. 'rajiv'. Press Enter to cancel.)\n");
    int src = ask_station("From station : ");
    if (src < 0) return;
    int dst = ask_station("To station   : ");
    if (dst < 0) return;
    if (src == dst) { printf("Start and destination are the same!\n"); return; }

    int path[MAXS];
    int n = find_route(src, dst, path);
    if (n == 0) { printf("No route found.\n"); return; }

    float total_km = 0, minutes = 0;
    int changes = 0;

    printf("\n" BOLD CYAN "  ROUTE: %s  ->  %s" RESET "\n\n", station[src], station[dst]);
    for (int i = 0; i < n; i++) {

        int ln = (i == 0) ? lineof[path[0]][path[1]]
                          : lineof[path[i - 1]][path[i]];
        printf("  %2d. %s%-22s" RESET, i + 1, line_col[ln], station[path[i]]);

        if (i == 0) printf(" START (%s Line)", line_name[ln]);
        else if (i == n - 1) printf(" " GREEN "DESTINATION" RESET);
        else {
            int next = lineof[path[i]][path[i + 1]];
            if (next != ln) {
                printf(" " BOLD "<< CHANGE: %s -> %s Line >>" RESET,
                       line_name[ln], line_name[next]);
                changes++;
            }
        }
        printf("\n");
        if (i > 0) {
            total_km += km[path[i - 1]][path[i]];
            minutes  += hop_time(km[path[i - 1]][path[i]]);
        }
    }
    minutes += changes * 5;

    time_t now = time(NULL);
    int sunday = (localtime(&now)->tm_wday == 0);
    int fare = fare_for(total_km, sunday);

    printf("\n  Stations     : %d stops\n", n - 1);
    printf("  Distance     : %.1f km (approx)\n", total_km);
    printf("  Interchanges : %d\n", changes);
    printf("  Travel time  : about %.0f minutes\n", minutes);
    printf("  Token fare   : Rs %d%s\n", fare, sunday ? "  (Sunday fare)" : "");
    printf("  Smart card   : about Rs %d  (10%% discount)\n", (int)(fare * 0.9f + 0.5f));
}

void show_line(void)
{
    printf("\n");
    for (int i = 0; i < NLINES; i++)
        printf("  %d. %s%s Line" RESET "\n", i + 1, line_col[i], line_name[i]);
    printf("Choose a line: ");
    char buf[10];
    read_line(buf, sizeof buf);
    int c = atoi(buf) - 1;
    if (c < 0 || c >= NLINES) { printf("Invalid line.\n"); return; }

    printf("\n  %s%s Line (%d stations)" RESET "\n", line_col[c], line_name[c], line_len[c]);
    for (int i = 0; i < line_len[c]; i++)
        printf("   %s%s %s" RESET "\n", line_col[c], i == 0 ? "O" : "|", line_stn[c][i]);
}

void show_interchanges(void)
{
    printf("\n  Interchange stations (where two or more lines meet):\n");
    for (int i = 0; i < nstations; i++) {
        int m = line_mask(i);
        if (m & (m - 1)) {
            printf("   * %-22s :", station[i]);
            for (int l = 0; l < NLINES; l++)
                if (m & (1 << l)) printf(" %s%s" RESET, line_col[l], line_name[l]);
            printf("\n");
        }
    }
}

int main(void)
{
    build_network();
    char buf[10];
    int choice;

    do {
        printf("\n" BOLD CYAN "===== DELHI METRO ROUTE PLANNER =====" RESET "\n");
        printf(" 1. Plan a journey\n");
        printf(" 2. View a metro line\n");
        printf(" 3. List interchange stations\n");
        printf(" 0. Exit\n");
        printf("Choice: ");
        read_line(buf, sizeof buf);
        choice = atoi(buf);

        switch (choice) {
            case 1: plan_journey();     break;
            case 2: show_line();        break;
            case 3: show_interchanges();break;
            case 0: printf("Happy journey! Mind the gap.\n"); break;
            default: printf("Invalid choice!\n");
        }
    } while (choice != 0);
    return 0;
}
