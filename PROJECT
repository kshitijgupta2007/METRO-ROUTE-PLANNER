#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <ctype.h>
#include <time.h>

#define MAXS 100
#define NLINES 4
#define INF 1e9f

const char *line_name[NLINES] = {"Yellow", "Blue", "Red", "Violet"};
const char *line_col[NLINES]  = {"\033[33m", "\033[34m", "\033[31m", "\033[35m"};
#define RESET "\033[0m"
#define BOLD  "\033[1m"
#define CYAN  "\033[36m"
#define GREEN "\033[32m"

char  station[MAXS][30];
int   nstations = 0;
float km[MAXS][MAXS];
int   lineof[MAXS][MAXS];

char  line_stn[NLINES][40][30];
int   line_len[NLINES];

int get_id(const char *name)
{
    for (int i = 0; i < nstations; i++)
        if (strcmp(station[i], name) == 0) return i;
    strcpy(station[nstations], name);
    return nstations++;
}

void add_line(int line, const char *names[], const float gaps[], int n)
{
    for (int i = 0; i < n; i++) {
        strcpy(line_stn[line][i], names[i]);
        if (i > 0) {
            int a = get_id(names[i - 1]), b = get_id(names[i]);
            km[a][b] = km[b][a] = gaps[i - 1];
            lineof[a][b] = lineof[b][a] = line;
        }
    }
    line_len[line] = n;
}

#define ADD(line, names, gaps) \
    add_line(line, names, gaps, (int)(sizeof(names) / sizeof(names[0])))

